MONGODB_URI=mongodb://localhost:27017/elev9
JWT_SECRET=change-me
PORT=3000

# Observability is disabled by default. Enable only with approved redaction and
# privacy policies. The local endpoint is the optional Collector boundary.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_SERVICE_NAME=elev9-api
OBSERVABILITY_SERVICE_VERSION=
OBSERVABILITY_ENVIRONMENT=local
OBSERVABILITY_OTLP_ENDPOINT=http://localhost:4318
OBSERVABILITY_EXPORT_PROTOCOL=http
OBSERVABILITY_EXPORT_TIMEOUT_MS=3000
OBSERVABILITY_SHUTDOWN_TIMEOUT_MS=5000
OBSERVABILITY_RESOURCE_ATTRIBUTES=
OBSERVABILITY_DIAGNOSTIC_LOG_LEVEL=error

AI_AGENT_RUNTIME_ENABLED=false
AI_AGENT_MAX_STEPS=6
AI_AGENT_SESSION_MEMORY_MAX_ITEMS=20
AI_AGENT_SESSION_MEMORY_TTL_MS=1800000
AI_AGENT_TOOLS_ENABLED=false
AI_AGENT_MAX_TOOL_CALLS=4
AI_AGENT_TOOL_TIMEOUT_MS=3000
